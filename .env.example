# ATAX / Google AI Studio configuration reference.
# This file is NOT loaded by every ATAX tool automatically. Copy only the keys
# consumed by your selected server or deployment target. Do not commit values.
# See docs/ENVIRONMENT_CONFIGURATION.md and docs/AI_STUDIO_REACT_HANDOFF.md.

# PUBLIC REACT CONFIGURATION (future UI only; safe to embed in browser bundles).
# Point to a separately authenticated backend you implement, not to privileged DB.
VITE_ATAX_API_BASE_URL=

# CANONICAL SUPABASE BACKEND (never put secret key in a VITE_*/NEXT_PUBLIC_* var).
SUPABASE_URL=
SUPABASE_SECRET_KEY=

# EXISTING SINGLE-OWNER MCP SERVER AUTH (choose a supported owner auth mode).
# This is the SHA-256 HEX DIGEST of an owner-only bearer, NOT the bearer itself.
MCP_SHARED_TOKEN_SHA256=
MCP_SHARED_SUBJECT=
MCP_SHARED_SCOPES=
# Optional externally-issued OAuth resource validation.
MCP_AUTH_AUTHORIZATION_SERVER=
MCP_AUTH_ISSUER=
MCP_AUTH_JWKS_URL=
MCP_AUTH_AUDIENCE=
MCP_ATAX_OWNER_JWT_SUBJECT=
MCP_AUTH_OWNER_SCOPES=
MCP_ALLOWED_ORIGINS=

# EXISTING MCP PROVIDER ACCOUNT NAMES (server/Worker secrets only).
# Add more uppercase alias suffixes as needed; examples use PERSONAL.
GH_KEY_PERSONAL=
CF_KEY_PERSONAL=
# GH_TOKEN_<ALIAS> and CLOUDFLARE_TOKEN_<ALIAS> are legacy alternatives.
# NEVER set both new and old token names for one provider/alias.

# EXISTING MCP FMRL OWNER CONFIGURATION (nonsecret policy).
MCP_GITHUB_OWNER=
MCP_FMRL_ALLOWED_TARGETS=

# RESERVED / NOT IMPLEMENTED: there is no Vercel provider adapter in MCP today.
# This is a FUTURE SERVER-ONLY token convention. Setting it enables nothing.
# VERCEL_TOKEN_PERSONAL=

# DEPLOYMENT/LOCAL CLI ONLY (not React and not automatically loaded by MCP).
# ATAX_MCP_CLOUDFLARE_API_TOKEN=  # GitHub Actions repository secret
# CLOUDFLARE_ACCOUNT_ID=          # manual deploy workflow input
# SUPABASE_PROJECT_ID=            # Supabase CLI
# SUPABASE_ACCESS_TOKEN=          # Supabase CLI secret
# SUPABASE_DB_PASSWORD=           # Supabase CLI secret
# ATAX_BRIDGE_REF=                # private GitHub controller variable
# ATAX_BRIDGE_ALLOWED_ACTORS=     # private GitHub controller variable
